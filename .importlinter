[importlinter]
root_package = scgsim
include_external_packages = True

[importlinter:contract:backend-independence]
name = Solver backends remain independent
type = independence
modules =
    scgsim.aedt
    scgsim.palace

[importlinter:contract:geometry-source]
name = Geometry source and models do not depend on planning or construction
type = forbidden
source_modules =
    scgsim.geometry.source
    scgsim.geometry.models
forbidden_modules =
    scgsim.geometry.planning
    scgsim.geometry.construction
    scgsim.geometry.compiler

[importlinter:contract:geometry-preparation-does-not-depend-on-compiler]
name = Geometry planning and construction do not depend on compiler
type = forbidden
source_modules =
    scgsim.geometry.planning
    scgsim.geometry.construction
forbidden_modules =
    scgsim.geometry.compiler

[importlinter:contract:shared-geometry]
name = Shared geometry does not depend on a solver backend
type = forbidden
source_modules =
    scgsim.geometry
forbidden_modules =
    scgsim.aedt
    scgsim.palace

[importlinter:contract:semantics]
name = Semantic facts remain independent of geometry solvers and presentation
type = forbidden
source_modules =
    scgsim.semantics
forbidden_modules =
    scgsim.geometry
    scgsim.aedt
    scgsim.palace
    scgsim.presentation
    scgsim.visualization
    scgsim.preparation
    scgsim.diagnostics
    numpy
    plotly
    gdsfactory
    gdstk
    gmsh
    shapely
    pyvista
    meshio
    ansys

[importlinter:contract:shared-presentation]
name = Shared presentation formats values without solver dependencies
type = forbidden
source_modules =
    scgsim.presentation
forbidden_modules =
    scgsim.aedt
    scgsim.palace

[importlinter:contract:sgb-core-independence]
name = SGB core does not depend on the replaced geometry paths
type = forbidden
source_modules =
    scgsim.geometry.sgb
forbidden_modules =
    scgsim.geometry.compiler
    scgsim.geometry.construction
    scgsim.geometry.planning.domain
    scgsim.geometry.planning.domain_planning
    scgsim.geometry.planning.surface_planning
    scgsim.geometry.planning.contact_planning
    scgsim.geometry.planning.topology_planning
    scgsim.geometry.planning.volume_planning
    scgsim.geometry.planning.port_planning
    scgsim.geometry.planning.evidence
    scgsim.geometry.planning.tags

[importlinter:contract:sgb-emission-layers]
name = SGB emission layers point one way (entry, exchange, verification, sidecar, writer)
type = layers
layers =
    scgsim.geometry.sgb.build
    scgsim.geometry.sgb.exchange
    scgsim.geometry.sgb.verification
    scgsim.geometry.sgb.sidecar
    scgsim.geometry.sgb.emission

[importlinter:contract:meshing-reads-contracts-only]
name = The meshing module reads the sidecar JSON and the XAO, never SGB, AEDT or Palace code
type = forbidden
source_modules =
    scgsim.meshing
forbidden_modules =
    scgsim.geometry
    scgsim.aedt
    scgsim.palace
