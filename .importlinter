[importlinter]
root_package = scgsim
include_external_packages = True

[importlinter:contract:backend-independence]
name = Solver backends remain independent
type = independence
modules =
    scgsim.aedt
    scgsim.palace

# The folders a layout passes through before SGB, in the order they import: the shared records, the shared
# grid operations, the source stage, the junction step and the physical interpretation that runs it.
# AEDT's planning reads them all. A folder reads the folders before it, never one after it; import-linter
# lists the last folder first.
[importlinter:contract:geometry-stage-layers]
name = Geometry stages import only the stages before them (models, grid, source, junctions, interpretation, planning)
type = layers
containers =
    scgsim.geometry
layers =
    planning
    interpretation
    junctions
    source
    grid
    models
# Every folder of scgsim.geometry is in this list or named here: a new folder has to take its place in
# the order. sgb and surface_epr are placed by the two contracts below.
exhaustive = true
exhaustive_ignores =
    sgb
    surface_epr

[importlinter:contract:shared-geometry]
name = Shared geometry does not depend on a solver backend
type = forbidden
source_modules =
    scgsim.geometry
forbidden_modules =
    scgsim.aedt
    scgsim.palace

[importlinter:contract:semantics]
name = Semantic facts remain independent of geometry solvers and presentation
type = forbidden
source_modules =
    scgsim.semantics
forbidden_modules =
    scgsim.geometry
    scgsim.aedt
    scgsim.palace
    scgsim.presentation
    scgsim.visualization
    scgsim.preparation
    scgsim.diagnostics
    numpy
    plotly
    gdsfactory
    gdstk
    gmsh
    shapely
    pyvista
    meshio
    ansys

[importlinter:contract:shared-presentation]
name = Shared presentation formats values without solver dependencies
type = forbidden
source_modules =
    scgsim.presentation
forbidden_modules =
    scgsim.aedt
    scgsim.palace

# SGB reads the shared records of geometry.models and no other geometry folder: the stages before it
# reach it through its input, never through their code.
[importlinter:contract:sgb-reads-records-only]
name = SGB reads only the shared geometry records
type = forbidden
source_modules =
    scgsim.geometry.sgb
# scgsim.geometry.* matches every folder of the geometry package, present or added later; import-linter
# skips scgsim.geometry.sgb itself, and the imports of the shared records are the ones allowed.
forbidden_modules =
    scgsim.geometry.*
ignore_imports =
    scgsim.geometry.sgb.** -> scgsim.geometry.models.**

# geometry.surface_epr and the Palace backend call SGB. The folders before it do not read it, with one
# stated exception: the junction partition binds rings with SGB's own exact vocabulary (sgb.exact), so its
# cut and SGB's arcs are decided by one implementation.
[importlinter:contract:stages-do-not-read-sgb]
name = The stages before SGB do not read it (the junction partition reads sgb.exact only)
type = forbidden
# scgsim.geometry.* matches every folder of the geometry package, present or added later; import-linter
# skips the forbidden folders themselves, and surface_epr calling SGB is the allowed direction.
source_modules =
    scgsim.geometry.*
forbidden_modules =
    scgsim.geometry.sgb
    scgsim.geometry.surface_epr
ignore_imports =
    scgsim.geometry.junctions.selection -> scgsim.geometry.sgb.exact.*
    scgsim.geometry.surface_epr.** -> scgsim.geometry.sgb.**
    scgsim.geometry.surface_epr.** -> scgsim.geometry.sgb

# SGB's folders in the order they import: a folder reads the folders before it, never one after it;
# import-linter lists the last first. This is the order of dependency. The order in time is the step list
# of sgb.model, where the arrangement runs twice: on the physical prisms alone, for the bands to find
# their support faces, then with the cut families the bands produce.
[importlinter:contract:sgb-stage-layers]
name = SGB stages import only the stages before them (errors, exact, prisms, arrangement, bands, topology, checks, model, output, section, build)
type = layers
containers =
    scgsim.geometry.sgb
layers =
    build
    section
    output
    model
    checks
    topology
    bands
    arrangement
    prisms
    exact
    errors
# Every folder and module of scgsim.geometry.sgb is in this list: a new one has to take its place in the order.
exhaustive = true

[importlinter:contract:sgb-emission-layers]
name = SGB emission layers point one way (entry, exchange, verification, sidecar, writer)
type = layers
layers =
    scgsim.geometry.sgb.build
    scgsim.geometry.sgb.output.exchange
    scgsim.geometry.sgb.output.verification
    scgsim.geometry.sgb.output.sidecar
    scgsim.geometry.sgb.output.emission

[importlinter:contract:contracts-import-nothing-else]
name = Stage contracts import nothing else from scgsim and no third-party package
type = forbidden
source_modules =
    scgsim.contracts
# scgsim.* matches every top-level subpackage; import-linter skips scgsim.contracts itself.
forbidden_modules =
    scgsim.*
    numpy
    plotly
    gdsfactory
    gdstk
    gmsh
    shapely
    pyvista
    meshio
    ansys

# The sidecar definition, scgsim.contracts.sgb_sidecar, is the one scgsim import meshing makes besides its own.
[importlinter:contract:meshing-reads-contracts-only]
name = The meshing module reads the sidecar JSON and the XAO, never SGB, AEDT or Palace code
type = forbidden
source_modules =
    scgsim.meshing
forbidden_modules =
    scgsim.geometry
    scgsim.aedt
    scgsim.palace
# The class A wall-column limit is one number, owned by the geometry layer's grid model.
ignore_imports =
    scgsim.meshing.fine_structure -> scgsim.geometry.models.grid

# The Palace stages in flow order: source, then mesh, then config, then run. A stage reads the stages
# before it, never one after it; import-linter lists the last stage first.
[importlinter:contract:palace-stage-layers]
name = Palace stages import only the stages before them (source, mesh, config, run)
type = layers
layers =
    scgsim.palace.run
    scgsim.palace.config
    scgsim.palace.mesh
    scgsim.palace.source

# A notebook displays what scgsim.visualization loads; no other package reads it.
# scgsim.* matches every top-level subpackage and module, present or added later; import-linter skips
# scgsim.visualization itself.
[importlinter:contract:nothing-reads-visualization]
name = No other package reads visualization
type = forbidden
source_modules =
    scgsim.*
forbidden_modules =
    scgsim.visualization

# AEDT records the sources its run can import, and that record includes the visualization loaders. They
# read a Palace run folder through scgsim.contracts alone, so a Palace change never alters AEDT provenance.
[importlinter:contract:visualization-reads-no-palace-code]
name = Visualization reads a Palace run folder through the contracts, never Palace or meshing code
type = forbidden
source_modules =
    scgsim.visualization
forbidden_modules =
    scgsim.palace
    scgsim.meshing
