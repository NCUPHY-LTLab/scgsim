{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scgsim.invalid/schemas/scgsim.sgb.sidecar.v2.json",
  "title": "scgsim.sgb.sidecar.v2",
  "description": "Sidecar of the SGB XAO/BREP: planned ids bound to native tags by construction order, primary physical groups with their semantic facts, unions, embeddings, lineage and the load-side expectations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "route", "route_policy", "grid_um", "tolerance_um", "model", "files", "binding", "counts", "physical_groups", "unions", "surface_epr_rows", "volumes", "faces", "embedded_faces", "refinement_edges", "mesh_features", "ports", "lineage", "insets", "refinements", "slivers", "arrangement", "curved_wall_faces", "surface_kinds", "expected"],
  "properties": {
    "schema": {"const": "scgsim.sgb.sidecar.v2"},
    "route": {"enum": ["A", "B", "C"]},
    "route_policy": {"$ref": "#/$defs/RoutePolicy"},
    "grid_um": {"type": "number", "exclusiveMinimum": 0},
    "tolerance_um": {"type": "number", "exclusiveMinimum": 0},
    "model": {"$ref": "#/$defs/ModelIdentity"},
    "files": {
      "description": "File names relative to the sidecar.",
      "type": "object",
      "additionalProperties": {"type": "string"},
      "propertyNames": {"enum": ["xao", "brep", "sidecar", "sliver_report", "validation_report"]}
    },
    "binding": {"$ref": "#/$defs/Binding"},
    "counts": {"$ref": "#/$defs/Counts"},
    "physical_groups": {
      "description": "Primary physical groups by name; they partition each dimension.",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"$ref": "#/$defs/SurfaceGroup"},
          {"$ref": "#/$defs/VolumeGroup"}
        ]
      }
    },
    "unions": {"$ref": "#/$defs/Unions"},
    "surface_epr_rows": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/SurfaceEprRow"}
    },
    "volumes": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/Volume"}
    },
    "faces": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/Face"}
    },
    "embedded_faces": {
      "description": "Sheets inside an emitted volume; the mesher embeds each face in its host volume.",
      "type": "array",
      "items": {"$ref": "#/$defs/EmbeddedFace"}
    },
    "refinement_edges": {
      "description": "Refinement-only curves; the mesher embeds each edge in its host face.",
      "type": "array",
      "items": {"$ref": "#/$defs/RefinementEdge"}
    },
    "mesh_features": {
      "description": "Facts about the geometry for the mesher (no sizes): film sidewalls, band boundaries, arcs, refinement curves, port edges. Sorted by kind, source and canonical JSON of the facts.",
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/FilmSidewall"},
          {"$ref": "#/$defs/BandBoundary"},
          {"$ref": "#/$defs/ArcFeature"},
          {"$ref": "#/$defs/RefinementCurve"},
          {"$ref": "#/$defs/PortEdge"}
        ]
      }
    },
    "ports": {
      "type": "array",
      "items": {"$ref": "#/$defs/Port"}
    },
    "lineage": {"$ref": "#/$defs/Lineage"},
    "insets": {
      "description": "The inset requests as given, by request id.  A concrete request is the record of its face; a type-level request lists the faces it was expanded into and the faces it skipped.",
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/InsetFace"},
          {"$ref": "#/$defs/InsetType"}
        ]
      }
    },
    "refinements": {
      "type": "array",
      "items": {"$ref": "#/$defs/Refinement"}
    },
    "slivers": {"$ref": "#/$defs/SliverSummary"},
    "arrangement": {"$ref": "#/$defs/Arrangement"},
    "curved_wall_faces": {
      "type": "array",
      "items": {"type": "string"}
    },
    "surface_kinds": {"$ref": "#/$defs/SurfaceKinds"},
    "expected": {"$ref": "#/$defs/Expected"}
  },
  "$defs": {
    "AdjacentDomain": {
      "description": "A solution region (vacuum or dielectric) on a side of the group's faces.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "material"],
      "properties": {
        "name": {"type": "string"},
        "kind": {"enum": ["vacuum", "dielectric"]},
        "material": {"type": "string"}
      }
    },
    "ArcFacts": {
      "description": "The facts of an arc feature.",
      "type": "object",
      "additionalProperties": false,
      "required": ["radius_um"],
      "properties": {
        "radius_um": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "ArcFeature": {
      "description": "The circular-arc edges of one carrier radius.",
      "type": "object",
      "additionalProperties": false,
      "required": ["edges", "native_tags", "kind", "source", "facts"],
      "properties": {
        "edges": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "native_tags": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "minItems": 1
        },
        "kind": {"const": "arc"},
        "source": {"description": "The one entity that owns the arcs; null when no single entity does.", "type": ["string", "null"]},
        "facts": {"$ref": "#/$defs/ArcFacts"}
      }
    },
    "Arrangement": {
      "description": "The measured snap drift and arc deviation of the arrangement (grid units), and the number of arc edges.",
      "type": "object",
      "additionalProperties": false,
      "required": ["max_snap_drift_grid", "max_arc_deviation_grid", "arc_edges"],
      "properties": {
        "max_snap_drift_grid": {"type": ["number", "null"]},
        "max_arc_deviation_grid": {"type": ["number", "null"]},
        "arc_edges": {"type": "integer", "minimum": 0}
      }
    },
    "BandBoundary": {
      "description": "The edges of an inset family; margins_um are the request's margins, ascending, and narrowest_band_um the smallest difference between consecutive margins with 0 prepended.",
      "type": "object",
      "additionalProperties": false,
      "required": ["edges", "native_tags", "kind", "source", "facts"],
      "properties": {
        "edges": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "native_tags": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "minItems": 1
        },
        "kind": {"const": "band_boundary"},
        "source": {"description": "The inset request id.", "type": "string"},
        "facts": {"$ref": "#/$defs/BandBoundaryFacts"}
      }
    },
    "BandBoundaryFacts": {
      "description": "The facts of a band boundary.",
      "type": "object",
      "additionalProperties": false,
      "required": ["margins_um", "narrowest_band_um"],
      "properties": {
        "margins_um": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0},
          "minItems": 1
        },
        "narrowest_band_um": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "BandLabel": {
      "description": "The inset band a group's faces lie in: the band family and the band index.",
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "index"],
      "properties": {
        "family": {"type": "string"},
        "index": {"type": "integer", "minimum": 0}
      }
    },
    "Binding": {
      "description": "Planned id <-> native tag per dimension, and the rule that relates them.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "ids_by_tag"],
      "properties": {
        "rule": {"type": "string"},
        "ids_by_tag": {"description": "Planned ids per dimension in native-tag order: tag = 1 + position.", "$ref": "#/$defs/IdsByTag"}
      }
    },
    "Carrier": {
      "description": "A carrier: a source polygon edge (entity, polygon, ring, edge), a cut-family member (family, member), or unknown.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["polygon_edge", "family_member", "unknown"]},
        "entity": {"type": "string"},
        "polygon": {"type": "integer"},
        "ring": {"type": "integer"},
        "edge": {"type": "integer"},
        "family": {"type": "string"},
        "member": {"type": "string"}
      }
    },
    "Counts": {
      "description": "Shapes of the written file by kind, and the number of planned volumes (volumes_total).",
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0},
      "required": ["vertices", "edges", "faces", "solids", "wires", "shells", "surfaces", "cylinders", "arcs", "pcurves", "free_faces", "free_edges", "volumes_total"],
      "properties": {
        "vertices": {"type": "integer", "minimum": 0},
        "edges": {"type": "integer", "minimum": 0},
        "faces": {"type": "integer", "minimum": 0},
        "solids": {"type": "integer", "minimum": 0},
        "wires": {"type": "integer", "minimum": 0},
        "shells": {"type": "integer", "minimum": 0},
        "surfaces": {"type": "integer", "minimum": 0},
        "cylinders": {"type": "integer", "minimum": 0},
        "arcs": {"type": "integer", "minimum": 0},
        "pcurves": {"type": "integer", "minimum": 0},
        "free_faces": {"type": "integer", "minimum": 0},
        "free_edges": {"type": "integer", "minimum": 0},
        "volumes_total": {"type": "integer", "minimum": 0}
      }
    },
    "EmbeddedFace": {
      "description": "A sheet face inside an emitted volume, and its group.",
      "type": "object",
      "additionalProperties": false,
      "required": ["face", "host_volume", "group"],
      "properties": {
        "face": {"type": "string"},
        "host_volume": {"type": "string"},
        "group": {"type": ["string", "null"]}
      }
    },
    "Expected": {
      "description": "What verify_loaded compares, by native tag (tag = 1 + position).",
      "type": "object",
      "additionalProperties": false,
      "required": ["vertices_um", "edge_vertices", "face_edges", "solid_faces", "face_area_um2", "solid_volume_um3"],
      "properties": {
        "vertices_um": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 3,
            "maxItems": 3
          }
        },
        "edge_vertices": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1},
            "minItems": 2,
            "maxItems": 2
          }
        },
        "face_edges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1}
          }
        },
        "solid_faces": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1}
          }
        },
        "face_area_um2": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "solid_volume_um3": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "Face": {
      "description": "One planned face: its group, kind, face kind, z range and the volumes on its two sides.",
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "kind", "face_kind", "z_um", "negative_volume", "positive_volume"],
      "properties": {
        "group": {"type": ["string", "null"]},
        "kind": {"enum": ["horizontal", "wall"]},
        "face_kind": {"enum": ["top", "bottom", "sidewall", "sheet", "port", "interface"]},
        "z_um": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 2,
          "maxItems": 2
        },
        "negative_volume": {"type": ["string", "null"]},
        "positive_volume": {"type": ["string", "null"]}
      }
    },
    "FilmSidewall": {
      "description": "Every edge of the sidewall faces of a finite body; thickness_um is the z extent of the sidewall column.",
      "type": "object",
      "additionalProperties": false,
      "required": ["edges", "native_tags", "kind", "source", "facts"],
      "properties": {
        "edges": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "native_tags": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "minItems": 1
        },
        "kind": {"const": "film_sidewall"},
        "source": {"description": "The entity id of the body.", "type": "string"},
        "facts": {"$ref": "#/$defs/FilmSidewallFacts"}
      }
    },
    "FilmSidewallFacts": {
      "description": "The facts of a film sidewall.",
      "type": "object",
      "additionalProperties": false,
      "required": ["thickness_um"],
      "properties": {
        "thickness_um": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "IdsByTag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["0", "1", "2", "3"],
      "properties": {
        "0": {
          "type": "array",
          "items": {"type": "string"}
        },
        "1": {
          "type": "array",
          "items": {"type": "string"}
        },
        "2": {
          "type": "array",
          "items": {"type": "string"}
        },
        "3": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "InsetFace": {
      "description": "One band family: the request of a face.  Every request that landed on the face asks these margins.",
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "support", "interface", "margins_um", "margins_grid", "band_count", "support_area_um2", "bands"],
      "properties": {
        "request_id": {"type": "string"},
        "support": {"type": "object"},
        "interface": {"type": ["string", "null"]},
        "margins_um": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "margins_grid": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        },
        "band_count": {"type": "integer", "minimum": 1},
        "support_area_um2": {"type": ["number", "null"]},
        "bands": {
          "description": "Band index -> primary groups.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "InsetType": {
      "description": "A type-level request (every face of a Surface-EPR type) with the families that carry its bands and the faces it left unbanded.",
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "support", "interface", "margins_um", "expansion"],
      "properties": {
        "request_id": {"type": "string"},
        "support": {"$ref": "#/$defs/TypeSupport"},
        "interface": {"type": "null"},
        "margins_um": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "expansion": {"$ref": "#/$defs/TypeExpansion"}
      }
    },
    "Lineage": {
      "description": "Every edge and face back to its source: edge carriers, carrier descriptions, wall columns, face sources and the area each Entity covers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["edges", "carriers", "vertical_edges", "faces", "membership"],
      "properties": {
        "edges": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "carriers": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/Carrier"}
        },
        "vertical_edges": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "faces": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "membership": {
          "description": "Face -> {Entity: covered fraction of the face area}; non-exclusive, may sum to more than 1.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "ModelIdentity": {
      "description": "The model's name and identity digest.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identity_digest"],
      "properties": {
        "name": {"type": "string"},
        "identity_digest": {"type": "string", "pattern": "^model:[0-9a-f]{16}$"}
      }
    },
    "NoFacts": {"description": "The facts of a feature kind that has none: an empty object.", "type": "object", "additionalProperties": false},
    "Port": {
      "description": "A lumped-port sheet: the authored identity, and the faces and volumes that carry it in the model.",
      "type": "object",
      "additionalProperties": false,
      "required": ["port_sheet_id", "group", "source_name", "port_index", "direction", "host_entity_ids", "source_layer", "target_layer", "z_um", "faces", "host_volumes", "adjacent_volumes"],
      "properties": {
        "port_sheet_id": {"type": "string"},
        "group": {"type": "string"},
        "source_name": {"type": "string"},
        "port_index": {"type": "integer"},
        "direction": {
          "type": "array",
          "items": {"type": "number"}
        },
        "host_entity_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "source_layer": {"type": "string"},
        "target_layer": {"type": "string"},
        "z_um": {"type": "number"},
        "faces": {
          "type": "array",
          "items": {"type": "string"}
        },
        "host_volumes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "adjacent_volumes": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "PortEdge": {
      "description": "The boundary edges of the faces of a lumped-port sheet.",
      "type": "object",
      "additionalProperties": false,
      "required": ["edges", "native_tags", "kind", "source", "facts"],
      "properties": {
        "edges": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "native_tags": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "minItems": 1
        },
        "kind": {"const": "port_edge"},
        "source": {"description": "The port sheet id.", "type": "string"},
        "facts": {"$ref": "#/$defs/NoFacts"}
      }
    },
    "Refinement": {
      "description": "A refinement request as given, and the edges it produced.",
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "z_um", "points_um", "edges"],
      "properties": {
        "request_id": {"type": "string"},
        "z_um": {"type": "number"},
        "points_um": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 2,
            "maxItems": 2
          }
        },
        "edges": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "RefinementCurve": {
      "description": "The refinement-only curves of a refinement request.",
      "type": "object",
      "additionalProperties": false,
      "required": ["edges", "native_tags", "kind", "source", "facts"],
      "properties": {
        "edges": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "native_tags": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "minItems": 1
        },
        "kind": {"const": "refinement_curve"},
        "source": {"description": "The refinement request id.", "type": "string"},
        "facts": {"$ref": "#/$defs/NoFacts"}
      }
    },
    "RefinementEdge": {
      "description": "A refinement-only edge in its host face, its cut family, and whether it is written as a free edge.",
      "type": "object",
      "additionalProperties": false,
      "required": ["edge", "host_face", "family", "written_as_free_edge"],
      "properties": {
        "edge": {"type": "string"},
        "host_face": {"type": "string"},
        "family": {"type": ["string", "null"]},
        "written_as_free_edge": {"type": "boolean"}
      }
    },
    "RoutePolicy": {
      "description": "Whether the route excludes or retains conductor volumes, and whether it allows conductor sheets.",
      "type": "object",
      "additionalProperties": false,
      "required": ["conductor_volumes", "conductor_sheets"],
      "properties": {
        "conductor_volumes": {"enum": ["excluded", "retained"]},
        "conductor_sheets": {"type": "boolean"}
      }
    },
    "SkippedFace": {
      "description": "A face a type-level request left unbanded, and why.",
      "type": "object",
      "additionalProperties": false,
      "required": ["support", "reason"],
      "properties": {
        "support": {"type": "object"},
        "reason": {"const": "no_gap_edge"}
      }
    },
    "SliverSummary": {
      "description": "Summary of the sliver report (measurements only; decision D2).",
      "type": "object",
      "properties": {
        "shortest_edge_um": {"type": ["number", "null"]},
        "narrowest_face_um": {"type": ["number", "null"]},
        "smallest_angle_deg": {"type": ["number", "null"]},
        "thin_slab_count": {"type": "integer"},
        "max_snap_drift_grid": {"type": ["number", "null"]},
        "max_arc_deviation_grid": {"type": ["number", "null"]}
      }
    },
    "SurfaceEprRow": {
      "description": "One Surface-EPR row and the primary group that carries it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "interface_type", "entities", "band", "side", "face_sides", "shared_face_group"],
      "properties": {
        "group": {"type": "string"},
        "interface_type": {"enum": ["MA", "MS", "SA"]},
        "entities": {
          "type": "array",
          "items": {"type": "string"}
        },
        "band": {"type": ["integer", "null"], "minimum": 0},
        "side": {"description": "A sheet row: the side every face in face_sides agrees on, or mixed when they disagree; null for any other row.", "enum": ["above", "below", "both", "mixed", null]},
        "face_sides": {
          "description": "A sheet row: face id -> the side of that face whose neighbour (vacuum for MA, dielectric for MS) the row integrates, listing exactly the faces that have such a neighbour; null for any other row.",
          "type": ["object", "null"],
          "additionalProperties": {"enum": ["above", "below", "both"]},
          "minProperties": 1
        },
        "shared_face_group": {"description": "The sheet group for a sheet row (its MA and MS rows integrate the same two-sided face), else null.", "type": ["string", "null"]}
      }
    },
    "SurfaceGroup": {
      "description": "One primary surface group (dimension 2) and the facts derived from its member faces.",
      "type": "object",
      "additionalProperties": false,
      "required": ["dim", "tag", "interface_type", "ids", "native_tags", "entities", "net", "face_kind", "adjacent_domains", "adjacent_volumes", "band", "area_um2"],
      "properties": {
        "dim": {"const": 2},
        "tag": {"type": "integer", "minimum": 1},
        "interface_type": {"description": "Derived from the face structure, never parsed from the group name; SHEET is a Route A conductor sheet, whose group is named by the bare entity id.", "enum": ["MA", "MS", "MM", "SA", "AA", "SS", "SHEET", "PORT", "EXT"]},
        "ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "native_tags": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        },
        "entities": {
          "type": "array",
          "items": {"type": "string"}
        },
        "net": {"type": ["string", "null"]},
        "face_kind": {"description": "The one face kind every face of the group has; it is part of the group name (PORT groups: port).", "enum": ["top", "bottom", "sidewall", "sheet", "port", "interface"]},
        "adjacent_domains": {
          "type": "array",
          "items": {"$ref": "#/$defs/AdjacentDomain"}
        },
        "adjacent_volumes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "band": {
          "oneOf": [
            {"$ref": "#/$defs/BandLabel"},
            {"type": "null"}
          ]
        },
        "area_um2": {"type": "number", "minimum": 0}
      }
    },
    "SurfaceKinds": {
      "description": "The number of planar and of cylindrical surfaces written.",
      "type": "object",
      "additionalProperties": false,
      "required": ["plane", "cylinder"],
      "properties": {
        "plane": {"type": "integer", "minimum": 0},
        "cylinder": {"type": "integer", "minimum": 0}
      }
    },
    "TypeExpansion": {
      "description": "The families a type-level request was expanded into, and the faces it skipped.",
      "type": "object",
      "additionalProperties": false,
      "required": ["banded", "skipped"],
      "properties": {
        "banded": {
          "description": "The families the physical pre-pass created, each as the record of its family (ids <request id>::<entity>::<side>, or of the first request on a shared face).  A port placed later can cover a whole face: read whether a family has bands from its own bands and from surface_epr_rows.",
          "type": "array",
          "items": {"$ref": "#/$defs/InsetFace"}
        },
        "skipped": {
          "type": "array",
          "items": {"$ref": "#/$defs/SkippedFace"}
        }
      }
    },
    "TypeSupport": {
      "description": "The faces a type-level request asks for: a Surface-EPR type, optionally only some face kinds, without the excluded Entities.",
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_type", "face_kinds", "exclude_entity_ids"],
      "properties": {
        "interface_type": {"enum": ["MA", "MS", "SA"]},
        "face_kinds": {
          "type": ["array", "null"],
          "items": {"enum": ["sheet", "top", "bottom", "interface"]}
        },
        "exclude_entity_ids": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "Unions": {
      "description": "Unions of primary groups as lists of group names: by interface type, and by Net (exposed conductor surfaces).",
      "type": "object",
      "additionalProperties": false,
      "required": ["interface_types", "nets"],
      "properties": {
        "interface_types": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "nets": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "Volume": {
      "description": "One planned volume: its domain, whether it is emitted, its group, shells, planned volume and AEDT name.",
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "kind", "material", "net", "emitted", "group", "shells", "volume_um3", "aedt_name"],
      "properties": {
        "entity": {"type": "string"},
        "kind": {"enum": ["vacuum", "dielectric", "conductor"]},
        "material": {"type": "string"},
        "net": {"type": ["string", "null"]},
        "emitted": {"type": "boolean"},
        "group": {"type": ["string", "null"]},
        "shells": {"type": "integer", "minimum": 1},
        "volume_um3": {"type": "number"},
        "aedt_name": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_]+$"}
      }
    },
    "VolumeGroup": {
      "description": "One primary volume group (dimension 3), named by the bare entity id.",
      "type": "object",
      "additionalProperties": false,
      "required": ["dim", "tag", "interface_type", "ids", "native_tags", "entities", "kind", "material", "net"],
      "properties": {
        "dim": {"const": 3},
        "tag": {"type": "integer", "minimum": 1},
        "interface_type": {"type": "null"},
        "ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "native_tags": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1}
        },
        "entities": {
          "type": "array",
          "items": {"type": "string"}
        },
        "kind": {"enum": ["vacuum", "dielectric", "conductor"]},
        "material": {"type": "string"},
        "net": {"type": ["string", "null"]}
      }
    }
  }
}
